#!/usr/bin/env bash
# InfraKit pre-push hook: run the test suite before code leaves the machine.
# Kept out of pre-commit so every commit stays fast; the suite is offline and
# takes seconds. Enable with `make hooks`.
set -euo pipefail

zero="0000000000000000000000000000000000000000"

# Only run when Python or templates actually changed on a pushed ref. git feeds
# "<local ref> <local sha> <remote ref> <remote sha>" per ref on stdin.
changed=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  if [ "$local_sha" = "$zero" ]; then
    continue  # branch deletion — nothing to test
  fi
  if [ "$remote_sha" = "$zero" ]; then
    changed=1  # new remote branch — no cheap base to diff, run the suite
    continue
  fi
  if git diff --name-only "$remote_sha" "$local_sha" -- '*.py' 'templates/**' 2>/dev/null | grep -q .; then
    changed=1
  fi
done

if [ "$changed" -eq 0 ]; then
  exit 0
fi

if command -v uv >/dev/null 2>&1; then
  exec uv run pytest
elif command -v pytest >/dev/null 2>&1; then
  exec pytest tests/
else
  echo "warning: uv/pytest not on PATH — skipped tests. CI will enforce them." >&2
fi
