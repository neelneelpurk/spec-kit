# https://editorconfig.org — keep editors consistent with ruff, the git hooks,
# and CI. Most editors apply this automatically; some need a plugin.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.py]
indent_size = 4

[*.{yml,yaml,json,jsonc,toml}]
indent_size = 2

[*.{sh,bash}]
indent_size = 2

[Makefile]
indent_style = tab

[*.md]
# Markdown uses two trailing spaces for hard line breaks.
trim_trailing_whitespace = false
indent_size = 2
